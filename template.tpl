scenarios:
- name: order always has 3 chunks, separators sent once-encoded
  code: |-
    referrer = 'https://www.google.com/';
    runCode(baseData());
    assertThat(sent.length).isEqualTo(1);
    assertThat(param(sent[0], 'order')).isEqualTo('https://shop.example.com/p?a=1|gtm.js|https://www.google.com/');
    assertThat(param(sent[0], 'order').split('|').length).isEqualTo(3);
    assertThat(sent[0].indexOf('buzz_key=broadlab')).isGreaterThan(0);
    assertThat(sent[0].indexOf('tag_id=99001&')).isGreaterThan(0);
    assertThat(sent[0].indexOf('segment_key=99000&')).isGreaterThan(0);
    assertApi('gtmOnSuccess').wasCalled();
