setup: |-
  const decodeUriComponent = require('decodeUriComponent');
  const templateStorage = require('templateStorage');

  // Uses GTM's real template storage (it can't be mocked with an object).
  // Cleared at the start of every test and on every simulated new page.
  templateStorage.clear();

  let sent = [];
  let cookies = {};
  let cookieOptionsSet = {};
  let now = 1793880000000;
  let referrer = '';
  let protocol = 'https';
  let pageUrl = 'https://shop.example.com/p?a=1';

  function baseData() {
    return {
      tagId: '99001',
      segmentKey: '99000',
      eventType: 'Custom',
      repeatFiring: 'default',
      valueParts: [],
      orderId: '',
      debug: true
    };
  }

  function newPage() {
    templateStorage.clear();
  }

  function param(url, key) {
    const parts = url.split('?')[1].split('&');
    for (let i = 0; i < parts.length; i++) {
      if (parts[i].indexOf(key + '=') === 0) {
        return decodeUriComponent(parts[i].substring(key.length + 1));
      }
    }
    return null;
  }

  function countTag(id) {
    let n = 0;
    for (let i = 0; i < sent.length; i++) {
      if (sent[i].indexOf('tag_id=' + id + '&') !== -1) n++;
    }
    return n;
  }

  mock('sendPixel', function(url, onSuccess, onFailure) {
    sent.push(url);
    onSuccess();
  });
  mock('getCookieValues', function(name) {
    const c = cookies[name];
    return c && c.expires > now ? [c.value] : [];
  });
  mock('setCookie', function(name, value, options) {
    cookies[name] = {value: value, expires: now + options['max-age'] * 1000};
    cookieOptionsSet[name] = options;
  });
  mock('getTimestampMillis', function() {
    return now;
  });
  mock('getUrl', function(part) {
    return part === 'protocol' ? protocol : pageUrl;
  });
  mock('getReferrerUrl', function() {
    return referrer;
  });
  mock('copyFromDataLayer', function(key) {
    return key === 'event' ? 'gtm.js' : undefined;
  });


