// Broadlab Pixel, template v2.0.0
// Design: "Broadlab GTM template v2: design review" (Optimisation, Nov 2026)

const sendPixel = require('sendPixel');
const encodeUriComponent = require('encodeUriComponent');
const logToConsole = require('logToConsole');
const generateRandom = require('generateRandom');
const getCookieValues = require('getCookieValues');
const setCookie = require('setCookie');
const getUrl = require('getUrl');
const getReferrerUrl = require('getReferrerUrl');
const copyFromDataLayer = require('copyFromDataLayer');
const getTimestampMillis = require('getTimestampMillis');
const makeString = require('makeString');
const makeNumber = require('makeNumber');
const getType = require('getType');
const templateStorage = require('templateStorage');

const VERSION = '2.0.0';
const ENDPOINT = 'https://cnv.event.prod.bidr.io/log/cnv';
const VISIT_SECONDS = 30 * 60;
const ORDER_SECONDS = 30 * 24 * 60 * 60;
const MAX_FIRED_KEYS = 40;
const MAX_ORDER_KEYS = 20;
const COOKIE_VISIT = '_bl_v';
const COOKIE_FIRED = '_bl_f';
const COOKIE_ORDERS = '_bl_o';
const SPACES = ' \t\n\r  ';
const NUMBER_STRIP = ['£', '$', '€', ' ', '\t', ' ', ' '];
const HASH_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.!~*\'()%';

const DEFAULT_REPEAT = {
  PageView: 'page',
  StoreLocator: 'every',
  AddToCart: 'every',
  Lead: 'every',
  SignUp: 'every',
  Custom: 'every',
  SiteVisit: 'visit',
  InitiateCheckout: 'visit',
  ProductView: 'visit_value',
  Configurator: 'visit_value',
  LeadStart: 'visit_value',
  Purchase: 'order'
};

// 0. Read the trigger event first, before anything else (same as {{Event}} for this run)
const triggerEvent = copyFromDataLayer('event');

function log(message, detail) {
  if (data.debug) {
    logToConsole('[Broadlab Pixel ' + VERSION + '] ' + message, detail === undefined ? '' : detail);
  }
}

// Always logged; the logging permission limits console output to GTM Preview
function warn(message) {
  logToConsole('[Broadlab Pixel ' + VERSION + '] Warning: ' + message);
}

function fail(message) {
  logToConsole('[Broadlab Pixel ' + VERSION + '] Not sent: ' + message);
  data.gtmOnFailure();
}

function trimText(s) {
  let start = 0;
  let end = s.length;
  while (start < end && SPACES.indexOf(s.charAt(start)) !== -1) start++;
  while (end > start && SPACES.indexOf(s.charAt(end - 1)) !== -1) end--;
  return s.substring(start, end);
}

function trimmed(v) {
  const t = getType(v);
  if (t === 'undefined' || t === 'null') return '';
  return trimText(makeString(v));
}

function isDigits(s) {
  if (!s) return false;
  for (let i = 0; i < s.length; i++) {
    if ('0123456789'.indexOf(s.charAt(i)) === -1) return false;
  }
  return true;
}

// Missing, undefined and null become empty; 0 is kept; a | inside the content becomes %7C
function clean(v) {
  const t = getType(v);
  if (t === 'undefined' || t === 'null') return '';
  const s = makeString(v);
  if (s === 'undefined' || s === 'null') return '';
  return s.split('|').join('%7C');
}

function countOf(s, ch) {
  return s.split(ch).length - 1;
}

// Turns a price in UK or European format into a plain number, e.g.
// £1,079.00 -> 1079.00, 1.079,00 € -> 1079.00, 12,50 -> 12.50, 1,079 -> 1079.
// A single dot is always a decimal point (1.079 -> 1.079), as in JavaScript numbers.
// A single comma followed by exactly 3 digits is a thousands separator.
// Returns null when the text is not a number.
function toNumber(raw) {
  let s = raw;
  for (let i = 0; i < NUMBER_STRIP.length; i++) {
    s = s.split(NUMBER_STRIP[i]).join('');
  }
  let sign = '';
  if (s.charAt(0) === '-') {
    sign = '-';
    s = s.substring(1);
  }
  if (s === '') return null;
  const lastDot = s.lastIndexOf('.');
  const lastComma = s.lastIndexOf(',');
  const dots = countOf(s, '.');
  const commas = countOf(s, ',');
  let decimalAt = -1;
  if (lastDot !== -1 && lastComma !== -1) {
    decimalAt = lastDot > lastComma ? lastDot : lastComma;
  } else if (dots === 1) {
    decimalAt = lastDot;
  } else if (commas === 1 && s.length - lastComma - 1 !== 3) {
    decimalAt = lastComma;
  }
  let intPart = decimalAt === -1 ? s : s.substring(0, decimalAt);
  const decPart = decimalAt === -1 ? '' : s.substring(decimalAt + 1);
  intPart = intPart.split('.').join('').split(',').join('');
  if (intPart === '' && decPart === '') return null;
  if (intPart !== '' && !isDigits(intPart)) return null;
  if (decPart !== '' && !isDigits(decPart)) return null;
  return sign + (intPart === '' ? '0' : intPart) + (decPart === '' ? '' : '.' + decPart);
}

// Short, non-reversible code for dedupe keys. Plain arithmetic, so it runs
// synchronously in any web container (no crypto API needed).
function shortCode(s) {
  const e = encodeUriComponent(s) || s;
  let h1 = 7;
  let h2 = 11;
  for (let i = 0; i < e.length; i++) {
    const c = HASH_CHARS.indexOf(e.charAt(i)) + 1;
    h1 = (h1 * 31 + c) % 2147483647;
    h2 = (h2 * 37 + c) % 1000000007;
  }
  return makeString(h1) + 'x' + makeString(h2);
}

const protocol = makeString(getUrl('protocol'));
const isHttps = protocol === 'https' || protocol === 'https:';

function cookieOptions(maxAge) {
  return {
    domain: 'auto',
    path: '/',
    'max-age': maxAge,
    secure: isHttps,
    samesite: 'Lax'
  };
}

function readCookie(name) {
  const values = getCookieValues(name);
  return values && values.length ? makeString(values[0]) : '';
}

function addKey(list, key, max) {
  list.push(key);
  return list.length > max ? list.slice(list.length - max) : list;
}

// 1. Validate IDs
const tagId = trimmed(data.tagId);
const segmentKey = trimmed(data.segmentKey);
if (!isDigits(tagId)) {
  fail('Tag ID "' + tagId + '" must be a number from your Broadlab spec.');
  return;
}
if (!isDigits(segmentKey)) {
  fail('Segment Key "' + segmentKey + '" must be a number from your Broadlab spec.');
  return;
}

// 2. Update the visit: more than 30 minutes since the last Broadlab tag ran starts a new visit
const now = getTimestampMillis();
const visitParts = readCookie(COOKIE_VISIT).split('.');
let visitId = visitParts[0] || '';
const lastActivity = makeNumber(visitParts[1]) || 0;
if (!visitId || !lastActivity || now - lastActivity > VISIT_SECONDS * 1000) {
  visitId = makeString(generateRandom(100000000, 999999999));
  log('New visit started', visitId);
}
setCookie(COOKIE_VISIT, visitId + '.' + now, cookieOptions(VISIT_SECONDS), false);

// The "already sent this visit" list is renewed together with the visit,
// so Once per visit holds for the whole visit, however long it lasts
const firedParts = readCookie(COOKIE_FIRED).split('~');
let fired = (firedParts[0] === visitId && firedParts[1]) ? firedParts[1].split('.') : [];
function saveFired() {
  setCookie(COOKIE_FIRED, visitId + '~' + fired.join('.'), cookieOptions(VISIT_SECONDS), false);
}
if (fired.length) saveFired();

// Build order and value now (no side effects), so repeat firing can use the value
// 4. order = Page URL | trigger event | Referrer
const pageUrl = makeString(getUrl());
const order = [clean(pageUrl), clean(triggerEvent), clean(getReferrerUrl())].join('|');

// 5. value = the parts the client listed, in order; empty parts keep their position
const rows = getType(data.valueParts) === 'array' ? data.valueParts : [];
const valueParts = [];
for (let i = 0; i < rows.length; i++) {
  let part = clean(rows[i].part);
  if (rows[i].sendAs === 'number' && part !== '') {
    const n = toNumber(part);
    if (n === null) {
      warn('Value part ' + (i + 1) + ' "' + part + '" is not a number, so it was sent empty.');
      part = '';
    } else {
      part = n;
    }
  }
  valueParts.push(part);
}
const value = valueParts.join('|');

// 3. Repeat firing
// Dedupe records are written before sending, not after: if two triggers run the
// same tag a moment apart (e.g. page load and consent event), the second run
// must already see the first, or both would send.
let mode = data.repeatFiring;
if (data.eventType === 'SiteVisit') mode = 'visit';
if (!mode || mode === 'default') mode = DEFAULT_REPEAT[data.eventType] || 'every';

if (mode === 'page') {
  const pageKey = 'bl_t' + tagId + '_' + shortCode(pageUrl);
  if (templateStorage.getItem(pageKey)) {
    log('Already sent on this page, skipped', pageUrl);
    data.gtmOnSuccess();
    return;
  }
  templateStorage.setItem(pageKey, true);
} else if (mode === 'visit' || mode === 'visit_value') {
  const key = mode === 'visit' ? 't' + tagId : 't' + tagId + '-' + shortCode(value);
  if (fired.indexOf(key) !== -1) {
    log('Already sent in this visit (' + mode + '), skipped', key);
    data.gtmOnSuccess();
    return;
  }
  fired = addKey(fired, key, MAX_FIRED_KEYS);
  saveFired();
} else if (mode === 'order') {
  const orderId = trimmed(data.orderId);
  if (orderId && orderId !== 'undefined' && orderId !== 'null') {
    const orderRaw = readCookie(COOKIE_ORDERS);
    let orders = orderRaw ? orderRaw.split('.') : [];
    const orderKey = 't' + tagId + '-' + shortCode(orderId);
    if (orders.indexOf(orderKey) !== -1) {
      log('Order already sent, skipped', orderKey);
      data.gtmOnSuccess();
      return;
    }
    orders = addKey(orders, orderKey, MAX_ORDER_KEYS);
    setCookie(COOKIE_ORDERS, orders.join('.'), cookieOptions(ORDER_SECONDS), false);
  } else {
    warn('Once per order, but Order ID is empty: sent without the duplicate check. A page refresh will count as a new purchase.');
  }
}

// 6. Send: order and value are each encoded once, as a whole
const url = ENDPOINT +
  '?tag_id=' + encodeUriComponent(tagId) +
  '&buzz_key=broadlab' +
  '&segment_key=' + encodeUriComponent(segmentKey) +
  '&order=' + encodeUriComponent(order) +
  '&value=' + encodeUriComponent(value) +
  '&ord=' + generateRandom(0, 9999999999);

log('Sending (' + data.eventType + ', ' + mode + ')', {order: order, value: value, url: url});
sendPixel(url, data.gtmOnSuccess, data.gtmOnFailure);


